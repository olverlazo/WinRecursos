        <script type="text/javascript" src="js/jquery-confirm.js"></script>
        <script src="js/jquery.validate.min.js" type="text/javascript"></script>
        <script  type="text/javascript">
            
              $(document).ready(function () {
                  var personadatos = <%= New System.Web.Script.Serialization.JavaScriptSerializer().Serialize(Session("datos"))%>
                     $('#nomuser').text(personadatos[4]);
                  $('#usercaja').text(personadatos[4] + " " + personadatos[5] + " " + personadatos[6]);
              });

              $('#salir').click(function () {
                  $.confirm({
                      title: 'Salir?',
                      content: 'Desea Salir del sistema!',
                      buttons: {
                          salir: {
                              btnClass: 'btn-red',
                              keys: ['enter', 'shift'],
                              action: function () {
                                  salirsistema();
                              }
                          },
                          cancelar: function () {
                          },
                      }
                  });
              });

              //GUARDAR DATOS DE LABORAL
              function salirsistema() {
                  $.ajax({
                      type: "POST",
                      contentType: "application/json; charset=utf-8",
                      url: "WebService2.asmx/salirsistema",
                      success: function (response) {
                          window.location = "/DefaultPersonal.aspx";
                      },
                      error: function ajaxError(result) {
                          alert(result.status + ' : ' + result.statusText);
                      }
                  });
              };
          </script>
